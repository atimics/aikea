{
  "name": "aikea",
  "version": "0.1.0",
  "description": "AIKEA — an MCP server that lets Claude design flat-pack furniture and turns it into CNC-ready DXFs, cut lists, hardware kits, IKEA-style instructions and a fabrication RFQ.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p . && node scripts/copy-assets.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "prepare": "npm run build",
    "studio": "node dist/index.js --http",
    "dev:studio": "tsx watch src/index.ts --http"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "furniture",
    "cnc",
    "dxf",
    "flat-pack",
    "woodworking"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "type": "module",
  "bin": {
    "aikea": "dist/cli.js",
    "aikea-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atimics/aikea.git"
  }
}
